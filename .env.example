# Local IaaS Backend (via Vite proxy atau direct localhost:8000):
VITE_API_URL=/v1/attendance/verify

# Untuk menguji langsung ke port 8000 tanpa proxy:
# VITE_API_URL=http://localhost:8000/v1/attendance/verify

# Untuk menguji AWS API Gateway (Serverless):
# VITE_API_URL=https://your-api-id.execute-api.us-east-1.amazonaws.com/v1/attendance/verify
